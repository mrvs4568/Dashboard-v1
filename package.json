{
  "name": "dash-stack-angular",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "dev": "ng serve --host 0.0.0.0 --port 3000 --disable-host-check",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@google/genai": "^1.52.0",
    "@google/generative-ai": "^0.21.0",
    "@lucide/angular": "^1.79.0",
    "chart.js": "^4.4.1",
    "echarts": "6.1.0",
    "motion": "^12.38.0",
    "ng2-charts": "^11.0.0",
    "ngx-echarts": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/node": "^22.14.0",
    "angular-eslint": "^22.8.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.1",
    "typescript": "~6.0.3"
  }
}
